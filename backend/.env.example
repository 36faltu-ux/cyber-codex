# ─────────────────────────────────────────────────────────────────────────────
# CYBER-AGENT AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB Atlas connection string.
# Obtain from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173 (Vite dev server)
# For production add your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173

# ── Node environment ──────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Window in milliseconds (default 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP (default 200)
RATE_LIMIT_MAX=200

# ── JWT (Phase 3 — Authentication) ───────────────────────────────────────────
# Long random string used to sign JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Token expiry in vercel zeit/ms notation (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# ── AI Provider (Phase 5 — Kira AI Chat, Scans, Reports) ─────────────────────
# The backend tries OpenAI first, then Gemini. Set one or both.
# If neither is set, Chat returns a demo response, Scans use heuristics only,
# and Reports generate a template summary — no crashes, just graceful fallback.

# Option A: OpenAI (recommended — gpt-4o-mini is fast and affordable)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Option B: Google Gemini
# Get your key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AI...
